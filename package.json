    "nodemailer": "^9.0.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
