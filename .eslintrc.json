{
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": "error",
    "no-undef": "warn"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": {
        "jest": true
      }
    },
    {
      "files": ["public/admin/js/*.js"],
      "env": {
        "browser": true,
        "node": false
      },
      "globals": {
        "marked": "readonly",
        "hljs": "readonly",
        "Chart": "readonly",
        "html2canvas": "readonly",
        "jsPDF": "readonly",
        "ExcelJS": "readonly",
        "QRCode": "readonly"
      }
    }
  ]
}
