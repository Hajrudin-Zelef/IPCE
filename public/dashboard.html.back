<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Mon Tableau de Bord — IPCE</title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1e3c72">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
  <link rel="stylesheet" href="/commercial/css/variables.css">
  <link rel="stylesheet" href="/commercial/css/dashboard.css">
</head>
<body>
  <div class="loading" id="loading">Chargement...</div>

  <div id="app" style="display:none;">
    <div class="topbar">
      <h2>IPCE Dashboard</h2>
      <div class="user-info">
        <button class="dark-toggle" id="dark-toggle" onclick="toggleDarkMode()" title="Basculer le th\u00e8me"></button>
        <div class="user-avatar-menu">
          <button class="user-avatar" id="user-avatar" onclick="toggleUserMenu()" title="Menu utilisateur"></button>
          <div class="user-dropdown" id="user-dropdown">
            <div class="dropdown-header">
              <div class="dropdown-avatar" id="dropdown-avatar"></div>
              <div>
                <div class="dropdown-name" id="dropdown-name"></div>
                <div class="dropdown-role" id="dropdown-role">Commercial</div>
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="#">&#128100; Profil</a>
            <a class="dropdown-item" onclick="toggleDarkMode();closeUserMenu()">&#127912; Apparence</a>
            <a class="dropdown-item" href="#">&#9881;&#65039; Param\u00e8tres</a>
            <a class="dropdown-item" href="#">&#10067; FAQ</a>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item dropdown-danger" onclick="logout()">&#128682; D\u00e9connexion</a>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <header>
        <h1>Mon Tableau de Bord</h1>
        <p>Suivi de mes collectes — <span id="date"></span></p>
      </header>

      <div class="section">Nouvelle Collecte</div>
      <div class="card">
        <h3>Saisir ma collecte</h3>
        <div class="form-row-3">
          <div class="form-group">
            <label>CA (FCFA)</label>
            <input type="number" id="inp-ca" min="0" placeholder="0" class="input-lg">
          </div>
          <div class="form-group">
            <label>Offres Émises</label>
            <input type="number" id="inp-offres" min="0" placeholder="0" class="input-lg">
          </div>
          <div class="form-group">
            <label>BC Signés</label>
            <input type="number" id="inp-bc" min="0" placeholder="0" class="input-lg">
          </div>
        </div>

        <div class="rdv-section">
          <div class="rdv-header">
            <label class="rdv-label">RDV <span class="rdv-counter" id="rdv-counter">0</span></label>
          </div>
          <div class="rdv-list" id="rdv-list"></div>
          <div class="rdv-form">
            <div class="rdv-inputs">
              <input type="text" id="rdv-prospect" placeholder="Prospect" class="rdv-input">
              <input type="date" id="rdv-date" class="rdv-input">
              <input type="number" id="rdv-montant" min="0" placeholder="Montant M" class="rdv-input rdv-input-sm">
              <select id="rdv-statut" class="rdv-input rdv-input-sm">
                <option>Prévu</option>
                <option>Réalisé</option>
                <option>Offre</option>
                <option>BC Signé</option>
              </select>
              <button class="btn btn-add-rdv" onclick="addRdv()">+</button>
            </div>
          </div>
        </div>

        <div class="btn-group">
          <button class="btn btn-success" onclick="saveCollecte()">
            <span class="btn-icon">&#128190;</span> Sauvegarder
          </button>
          <button class="btn btn-warning" onclick="validateCollecte()">
            <span class="btn-icon">&#10003;</span> Valider et envoyer
          </button>
        </div>
      </div>

      <div class="section">Historique de mes collectes</div>
      <div class="card">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>CA</th>
              <th>Offres</th>
              <th>BC</th>
              <th>RDV</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="history-body"></tbody>
        </table>
        <div class="empty" id="empty-history">Aucune collecte pour le moment</div>
      </div>

      <div class="section">Mes Graphiques</div>
      <div class="charts">
        <div class="chart"><canvas id="ch-ca"></canvas></div>
        <div class="chart"><canvas id="ch-offres"></canvas></div>
        <div class="chart"><canvas id="ch-bc"></canvas></div>
      </div>

      <div class="section">Mon Calendrier</div>
      <div class="card">
        <div class="cal-toggle">
          <button class="cal-toggle-btn active" data-view="month" onclick="calToggleView('month',this)">Vue Mois</button>
          <button class="cal-toggle-btn" data-view="timeline" onclick="calToggleView('timeline',this)">Timeline</button>
        </div>
        <div class="cal-nav">
          <button class="btn btn-sm btn-primary" onclick="calPrevMonth()">&#9664;</button>
          <span id="cal-month-label"></span>
          <button class="btn btn-sm btn-primary" onclick="calNextMonth()">&#9654;</button>
        </div>
        <div id="cal-month-view"></div>
        <div id="cal-timeline-view" style="display:none;"></div>
      </div>
    </div>
  </div>

  <!-- Modal détail du jour -->
  <div class="cal-modal-overlay" id="cal-day-modal" style="display:none;">
    <div class="cal-modal">
      <div class="cal-modal-header">
        <h3 id="cal-day-title">RDV du jour</h3>
        <button class="cal-modal-close" onclick="calCloseDayModal()">&#10005;</button>
      </div>
      <div class="cal-modal-body" id="cal-day-body"></div>
      <div class="cal-modal-actions">
        <button class="btn btn-sm" style="background:var(--border);" onclick="calCloseDayModal()">Fermer</button>
      </div>
    </div>
  </div>

  <!-- Modal détail collecte -->
  <div class="cal-modal-overlay" id="cal-collecte-modal" style="display:none;">
    <div class="cal-modal">
      <div class="cal-modal-header">
        <h3 id="cal-collecte-title">Détails de la collecte</h3>
        <button class="cal-modal-close" onclick="document.getElementById('cal-collecte-modal').style.display='none'">&#10005;</button>
      </div>
      <div class="cal-modal-body" id="cal-collecte-body"></div>
      <div class="cal-modal-actions">
        <button class="btn btn-sm" style="background:var(--border);" onclick="document.getElementById('cal-collecte-modal').style.display='none'">Fermer</button>
      </div>
    </div>
  </div>

  <!-- Modal détail RDV -->
  <div class="cal-modal-overlay" id="cal-modal" style="display:none;">
    <div class="cal-modal">
      <div class="cal-modal-header">
        <h3>Détails du RDV</h3>
        <button class="cal-modal-close" onclick="calCloseModal()">&#10005;</button>
      </div>
      <div class="cal-modal-body">
        <div class="cal-modal-field">
          <label>Prospect</label>
          <span id="cal-modal-prospect"></span>
        </div>
        <div class="cal-modal-field">
          <label>Date</label>
          <span id="cal-modal-date"></span>
        </div>
        <div class="cal-modal-field">
          <label>Montant</label>
          <span id="cal-modal-montant"></span>
        </div>
        <div class="cal-modal-field">
          <label>Statut</label>
          <select id="cal-modal-statut" class="cal-statut-select">
            <option value="Prevu">Prévu</option>
            <option value="Realise">Réalisé</option>
            <option value="Offre">Offre</option>
            <option value="BC Signe">BC Signé</option>
          </select>
        </div>
        <div id="cal-modal-readonly" style="display:none; font-size:12px; color:var(--warning); margin-top:8px;">
          Collecte déjà validée — modification impossible.
        </div>
      </div>
      <div class="cal-modal-actions">
        <button class="btn btn-success btn-sm" id="cal-btn-save" onclick="calSaveStatut()">Enregistrer</button>
        <button class="btn btn-danger btn-sm" id="cal-btn-delete" onclick="calDeleteRdv()">Supprimer</button>
        <button class="btn btn-sm" style="background:var(--border);" onclick="calCloseModal()">Fermer</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast-container" id="toast-container"></div>

  <!-- Scripts -->
  <script src="/commercial/js/dashboard-app.js"></script>
  <script src="/commercial/js/dashboard-collectes.js"></script>
  <script src="/commercial/js/dashboard-history.js"></script>
  <script src="/commercial/js/dashboard-charts.js"></script>
  <script src="/commercial/js/dashboard-calendar.js"></script>
  <script src="/admin/js/notifications.js"></script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
</body>
</html>
